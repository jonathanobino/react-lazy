{
  "name": "lazy-react",
  "version": "3.6.1",
  "description": "components to lazy load iframes, images and images as backgrounds",
  "source": "./src/index.tsx",
  "main": "./dist/index.js",
  "scripts": {
    "start": "parcel serve ./src/demo/index.html --dist-dir ./demo",
    "build": "parcel build",
    "lint": "biome lint src/*",
    "format": "biome format --write ./src/*.tsx",
    "precommit": "lint-staged",
    "test": "jest"
  },
  "targets": {
    "main": {
      "optimize": true
    }
  },
  "lint-staged": {
    "src/*.jsx": [
      "biome format",
      "git add"
    ]
  },
  "keywords": [
    "react",
    "lazy-load"
  ],
  "author": "Jonathan Obino",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanobino/react-lazy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^17.0.21",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "husky": "^4.3.0",
    "jest": "^27.5.1",
    "lint-staged": "^10.4.0",
    "parcel": "^2.7.0",
    "process": "^0.11.10"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
